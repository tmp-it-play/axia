# Inject these values into the server process environment. This file is not loaded automatically.
AXIA_DATABASE_URL=jdbc:mysql://127.0.0.1:3306/axia
AXIA_DATABASE_USER=
AXIA_DATABASE_PASSWORD=

AXIA_DATAGSM_CLIENT_ID=
AXIA_DATAGSM_THEMOMENT_CLUB_ID=
AXIA_DATAGSM_REDIRECT_URI=https://kimtaeeun.site/axia/api/auth/datagsm/callback
# Provider-issued 64-character lowercase hex string; use it literally, without hex decoding.
AXIA_DATAGSM_EVENT_SECRET=

AXIA_GITHUB_APP_ID=
AXIA_GITHUB_INSTALLATION_ID=
# PEM private key; escaped \n sequences are accepted.
AXIA_GITHUB_PRIVATE_KEY=
AXIA_GITHUB_WEBHOOK_SECRET=

# Use three independent, randomly generated values of at least 32 UTF-8 bytes each.
AXIA_ACCESS_TOKEN_SECRET=
AXIA_AUTH_TRANSACTION_SECRET=
AXIA_REFRESH_CREDENTIAL_SECRET=

# Scheduler periods in seconds. Separate replicas share MySQL leases and wake-up requests.
AXIA_GITHUB_INCREMENTAL_SECONDS=900
AXIA_GITHUB_FULL_SECONDS=21600
AXIA_GITHUB_REDELIVERY_SECONDS=21600
AXIA_REMINDER_SECONDS=60
AXIA_HEALTH_SECONDS=30
