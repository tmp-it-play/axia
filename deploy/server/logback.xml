<configuration>
    <!-- Host logrotate owns the daily/14-day policy, including idle or stopped application logs. -->
    <appender name="SERVER_JSON" class="ch.qos.logback.core.FileAppender">
        <file>/var/log/axia/server.json</file>
        <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
            <withContext>false</withContext>
            <withArguments>false</withArguments>
            <withMessage>false</withMessage>
            <withFormattedMessage>true</withFormattedMessage>
            <withThrowable>false</withThrowable>
        </encoder>
    </appender>
    <root level="${AXIA_LOG_LEVEL:-INFO}">
        <appender-ref ref="SERVER_JSON"/>
    </root>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="io.ktor.client" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
</configuration>
