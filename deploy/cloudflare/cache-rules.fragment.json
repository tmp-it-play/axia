{
  "rules": [
    {
      "description": "Axia API and signed webhook responses must bypass cache",
      "expression": "(http.host eq \"kimtaeeun.site\" and (http.request.uri.path eq \"/axia/api\" or starts_with(http.request.uri.path, \"/axia/api/\")))",
      "action": "set_cache_settings",
      "action_parameters": { "cache": false },
      "enabled": true
    },
    {
      "description": "Axia update feeds must be checked against the current signed release",
      "expression": "(http.host eq \"kimtaeeun.site\" and http.request.uri.path in {\"/axia/updates/macos/arm64/appcast.xml\" \"/axia/updates/windows/x64/appcast.xml\"})",
      "action": "set_cache_settings",
      "action_parameters": { "cache": false },
      "enabled": true
    }
  ]
}
