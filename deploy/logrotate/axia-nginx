/var/log/nginx/axia-access.json {
    daily
    rotate 14
    maxage 14
    missingok
    ifempty
    compress
    delaycompress
    dateext
    create 0640 root root
    sharedscripts
    postrotate
        if [ -s /run/nginx.pid ]; then
            /usr/sbin/nginx -s reopen
        fi
    endscript
}
